{
    "compilerOptions": {
        "target": "ES2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "baseUrl": ".",
        "paths": {
            "@kore/ui": [
                "packages/ui/index"
            ],
            "@kore/api": [
                "packages/api/index"
            ],
            "@kore/core": [
                "packages/core/index"
            ]
        }
    },
    "include": [
        "packages/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "supabase",
        "stripe",
        "apps"
    ]
}